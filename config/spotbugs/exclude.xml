<FindBugsFilter>
    <!-- Alle skjermene i ui skal dele den samme sesjonen med den innloggede brukeren, ikke
         en kopi. Gjelder bare feltet userSession i ui. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2" />
        <Class name="~ui\..*" />
        <Field name="userSession" />
    </Match>
    <!-- ReviewService skal bruke lagringen den får fra App, ikke en kopi.
         Unntaket gjelder bare dette ene feltet. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2" />
        <Class name="core.ReviewService" />
        <Field name="reviewRepository" />
    </Match>
    <!-- Navigation bruker repository-et som en injisert avhengighet. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2" />
        <Class name="ui.Navigation" />
        <Field name="reviewRepository" />
    </Match>
    <!-- SpotBugs regner ReviewService som endringsbar fordi den har deleteReview. Den er en
         delt tjeneste som kontrollerne skal bruke direkte, ikke kopiere. Gjelder bare feltet
         reviewService i ui og rest. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2" />
        <Class name="~(ui|rest\.api)\..*" />
        <Field name="reviewService" />
    </Match>
</FindBugsFilter>