@startuml restArkitektur

title REST-arkitektur - BIThub

node "JavaFX-klient" {
    component "ui" as ui
    component "core" as coreKlient
}

node "REST-server (Spring Boot)" {
    component "springboot/restserver" as rest
    component "core" as coreServer
    component "file" as fileModul
}

database "&#126;/.bithub" {
    artifact "courses.json" as courses
    artifact "users.json" as users
}

ui --> coreKlient : ReviewService\nog domeneklassene
ui --> rest : HTTP + JSON\nAuthorization: Bearer <token>
rest --> coreServer : ReviewService\nog UserService
rest --> fileModul : oppretter ReviewHandler\nog UserHandler
fileModul ..> coreServer : implementerer ReviewRepository\nog UserRepository
fileModul --> courses
fileModul --> users

note right of rest
  GET /api/courses og /api/courses/{code}
  POST /api/courses/{code}/reviews
  PUT og DELETE /api/reviews/{id}
  POST /api/users, /api/login og /api/logout
  PUT /api/users/{email}/password og /name
  GET /api/me/reviews
end note

@enduml