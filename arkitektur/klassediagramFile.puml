@startuml klassediagramFile
hide empty members

title Klassediagram for file

package core {
    interface ReviewRepository
    interface UserRepository
    class Course
    class Review
    class User
}

package file {
    class ReviewHandler {
        - path: Path {readOnly}
        - storage: JsonFileStorage {readOnly}
        + addReview(courseCode, courseName, review)
        + findCourse(courseCode): Optional<Course>
        + findAllCourses(): List<Course>
        + addCoursesIfMissing(courses)
        + findReview(reviewId): Optional<Review>
        + updateReview(reviewId, rating, comment, anonymous): boolean
        + deleteReview(reviewId): boolean
        + updateReviewerName(ownerEmail, reviewerName): int
    }

    class UserHandler {
        - path: Path {readOnly}
        - storage: JsonFileStorage {readOnly}
        + save(user)
        + addUserIfEmailAvailable(user): boolean
        + update(user)
        + findByEmail(email): Optional<User>
    }
}

package file.storage {
    interface "DataHandler<T>" as DataHandler {
        + readFromFile(): List<T>
        + writeToFile(data: List<T>)
        + isEmpty(): boolean
    }

    class JsonFileStorage {
        - {static} LOCKS: Map<Path, ReentrantReadWriteLock>
        - path: Path {readOnly}
        - lock: ReentrantReadWriteLock {readOnly}
        + read(operation): T
        + update(operation): T
        + write(data)
    }

    note bottom of JsonFileStorage
      En lås per fil, delt av alle handlere som bruker samme fil.
      update holder skrivelåsen gjennom les, endre og skriv.
      write skriver til en midlertidig fil og flytter den over originalen.
    end note
}

package file.dto {
    class CourseDTO {
        - courseCode: String
        - courseName: String
        - reviews: List<ReviewDTO>
    }

    class ReviewDTO {
        - id: String
        - ownerEmail: String
        - reviewerName: String
        - anonymous: boolean
        - rating: int
        - comment: String
    }

    class UserDTO {
        - name: String
        - email: String
        - passwordHash: String
        - salt: String
    }

    note bottom of UserDTO
      DTO-ene har også en tom konstruktør,
      gettere og settere for Jackson.
      De er utelatt her.
    end note
}

ReviewRepository <|.. ReviewHandler
UserRepository <|.. UserHandler
Course <.. ReviewHandler : gjør om til
Review <.. ReviewHandler : gjør om til
User <.. UserHandler : gjør om til

ReviewHandler ..|> DataHandler : <<bind>> T = CourseDTO
UserHandler ..|> DataHandler : <<bind>> T = UserDTO
ReviewHandler --> "1" JsonFileStorage : storage
UserHandler --> "1" JsonFileStorage : storage

ReviewHandler ..> CourseDTO : leser og skriver
UserHandler ..> UserDTO : leser og skriver
CourseDTO "1" o-- "*" ReviewDTO : reviews

@enduml