@startuml
!pragma layout smetana
hide empty members

title Klassediagram for file

package core {
    interface ReviewRepository
    interface UserRepository
    class Course
    class Review
    class User
}

package file {
    class ReviewHandler {
        - path: Path {readOnly}
        - storage: JsonFileStorage {readOnly}
        + addReview(courseCode, courseName, review: Review)
        + findCourse(courseCode: String): Optional<Course>
        + findAllCourses(): List<Course>
        + addCoursesIfMissing(courses: List<Course>)
        + updateReview(reviewId, rating, comment, anonymous): boolean
        + deleteReview(reviewId: String): boolean
    }

    class UserHandler {
        - path: Path {readOnly}
        - storage: JsonFileStorage {readOnly}
        + save(user: User)
        + addUserIfEmailAvailable(user: User): boolean
        + update(user: User)
        + findByEmail(email: String): Optional<User>
    }
}

package file.storage {
    interface "DataHandler<T>" as DataHandler {
        + readFromFile(): List<T>
        + writeToFile(data: List<T>)
        + isEmpty(): boolean
    }

    class JsonFileStorage {
        - path: Path {readOnly}
        - lock: ReentrantReadWriteLock {readOnly}
        + read(operation): T
        + update(operation): T
        + write(data: Object)
    }
}

package file.dto {
    class CourseDTO {
        - courseCode: String
        - courseName: String
        - reviews: List<ReviewDTO>
    }

    class ReviewDTO {
        - id: String
        - ownerEmail: String
        - reviewerName: String
        - anonymous: boolean
        - rating: int
        - comment: String
    }

    class UserDTO {
        - name: String
        - email: String
        - passwordHash: String
        - salt: String
    }
}

ReviewHandler ..|> ReviewRepository
ReviewHandler ..|> DataHandler : <<bind>> T = CourseDTO
UserHandler ..|> UserRepository
UserHandler ..|> DataHandler : <<bind>> T = UserDTO

ReviewHandler --> "1" JsonFileStorage : storage
UserHandler --> "1" JsonFileStorage : storage

CourseDTO "1" o-- "*" ReviewDTO : reviews
ReviewHandler ..> CourseDTO : leser og skriver
ReviewHandler ..> Course : gjør om til
ReviewHandler ..> Review : gjør om til
UserHandler ..> UserDTO : leser og skriver
UserHandler ..> User : gjør om til

note bottom of JsonFileStorage
  Én lås per fil, delt av alle handlere som bruker samme fil.
  update holder skrivelåsen gjennom les, endre og skriv.
  write skriver til en midlertidig fil og flytter den over originalen.
end note

note bottom of UserDTO
  DTO-ene har også en tom konstruktør,
  gettere og settere for Jackson. De er utelatt her.
end note

@enduml