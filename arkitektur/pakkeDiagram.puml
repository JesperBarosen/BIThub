@startuml pakkeDiagram
set separator none

title Pakkediagram - BIThub

component "ui" as uiModul {
    package ui
    package ui.controller
    package ui.client
    package ui.session
    package ui.util
}

component "springboot/restserver" as restModul {
    package rest
    package rest.api
    package rest.auth
    package rest.model
    package rest.exception
}

component "file" as fileModul {
    package file
    package file.dto
    package file.storage
}

component "core" as coreModul {
    package core.model
    package core.service
    package core.repository
    package core.exception
}

component "JavaFX" as javafx
component "ControlsFX" as controlsfx
component "java.net.http" as httpClient
component "Jackson" as jackson
component "Spring Boot" as springboot

uiModul .right[#D85A30].> restModul : HTTP + JSON\n(ikke en Maven-avhengighet)
uiModul ..> coreModul
restModul ..> fileModul
restModul ..> coreModul
fileModul ..> coreModul

uiModul ..> javafx
uiModul ..> controlsfx
uiModul ..> httpClient
uiModul ..> jackson
fileModul ..> jackson
restModul ..> springboot
@enduml