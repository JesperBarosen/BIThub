@startuml
!pragma layout smetana

title Klassediagram for core

package core.model {
    class Course {
        - courseCode: String
        - courseName: String
        - reviews: List<Review>
        + getCourseCode(): String
        + getCourseName(): String
        + addReview(review: Review)
        + getReviews(): List<Review>
        + getAverageRating(): double
    }

    class Review {
        - id: String {readOnly}
        - ownerEmail: String {readOnly}
        - reviewerName: String {readOnly}
        - anonymous: boolean {readOnly}
        - rating: int {readOnly}
        - comment: String {readOnly}
        + getAuthorType(): AuthorType
        + getDisplayName(): String
        + getRating(): int
        + getComment(): String
    }

    enum AuthorType {
        USER
        ANONYMOUS
        GUEST
    }

    class User {
        - name: String {readOnly}
        - email: String {readOnly}
        - passwordHash: String {readOnly}
        - salt: String {readOnly}
        + getName(): String
        + getEmail(): String
        + verifyPassword(password: String): boolean
    }
}

package core.service {
    class ReviewService {
        + submitReview(courseCode, courseName, owner: User, anonymous, ratingText, comment): Review
        + getAllCourses(): List<Course>
        + getCourseWithReviews(course: Course): Course
        + findReviewsByOwner(ownerEmail: String): List<Course>
        + updateReview(reviewId, ownerEmail, ratingText, comment, anonymous): Review
        + deleteReview(reviewId: String, ownerEmail: String)
    }

    class UserService {
        + register(name, email, password): User
        + login(email, password): Optional<User>
        + findByEmail(email: String): Optional<User>
        + changePassword(email, oldPassword, newPassword)
    }

    class PasswordHasher {
        + {static} generateSalt(): String
        + {static} hashPassword(password, salt): String
        + {static} verifyPassword(password, salt, expectedHash): boolean
    }

    class DefaultCourses {
        + {static} all(): List<Course>
    }
}

package core.repository {
    interface ReviewRepository {
        + addReview(courseCode, courseName, review: Review)
        + findCourse(courseCode: String): Optional<Course>
        + findAllCourses(): List<Course>
        + addCoursesIfMissing(courses: List<Course>)
        + updateReview(reviewId, rating, comment, anonymous): boolean
        + deleteReview(reviewId: String): boolean
    }

    interface UserRepository {
        + save(user: User)
        + findByEmail(email: String): Optional<User>
        + update(user: User)
    }
}

package core.exception {
    class ReviewNotFoundException
    class NotReviewOwnerException
    class DuplicateEmailException
}

Course "1" o-- "*" Review : reviews
Review ..> AuthorType
User ..> PasswordHasher : hasher og sjekker passord

ReviewService --> "1" ReviewRepository : reviewRepository
UserService --> "1" UserRepository : userRepository
ReviewService ..> ReviewNotFoundException : kaster
ReviewService ..> NotReviewOwnerException : kaster
UserRepository ..> DuplicateEmailException : save kaster
DefaultCourses ..> Course

ReviewRepository ..> Course
ReviewRepository ..> Review
UserRepository ..> User

note bottom of ReviewRepository
  Implementeres av ReviewHandler i file (på serveren)
  og RemoteReviewRepository i ui (i klienten).
end note

note bottom of UserRepository
  Implementeres av UserHandler i file.
end note

@enduml