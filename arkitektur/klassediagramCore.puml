@startuml klassediagramCore

package core {

    class Course {
        - courseCode: String
        - courseName: String
        - reviews: List<Review>
        + Course(courseCode: String, courseName: String)
        + String getCourseCode()
        + String getCourseName()
        + void addReview(review: Review)
        + List<Review> getReviews()
        + double getAverageRating()
    }

    class Review {
        - reviewerName: String {readOnly}
        - rating: int {readOnly}
        - comment: String {readOnly}
        + Review(reviewerName: String, rating: int, comment: String)
        + String getReviewerName()
        + int getRating()
        + String getComment()
    }

    class User {
        - name: String
        - email: String
        - password: String
        + User(name: String, email: String, password: String)
        + String getName()
        + String getEmail()
        + String getPassword()
    }

    interface ReviewRepository {
        + void addReview(courseCode: String, courseName: String, review: Review)
        + Optional<Course> findCourse(courseCode: String)
    }

    class ReviewService {
        - reviewRepository: ReviewRepository {readOnly}
        + ReviewService(reviewRepository: ReviewRepository)
        + void submitReview(courseCode: String, courseName: String, reviewerName: String, ratingText: String, comment: String)
        + Course getCourseWithReviews(course: Course)
        - {static} int parseRating(ratingText: String)
    }

    Course --> "reviews: *" Review
    ReviewService --> "reviewRepository: 1" ReviewRepository
    ReviewService ..> Course : henter via ReviewRepository.findCourse(String)
    ReviewService ..> Review : oppretter i submitReview(...)
    ReviewRepository ..> Course
    ReviewRepository ..> Review
}

note bottom of ReviewRepository
  Implementeres av ReviewHandler i file-modulen,
  så core ikke er avhengig av hvordan data lagres.
end note

@enduml