<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>
<?import org.controlsfx.control.Rating?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
   prefHeight="600.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/21"
   xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.controller.EditReviewController">
   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="90.0" styleClass="header-bar"
         stylesheets="@Style.css">
         <children>
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Label alignment="CENTER" prefHeight="70.0" prefWidth="250.0" text="BIThub">
               <font>
                  <Font name="System Bold" size="40.0" />
               </font>
            </Label>
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Button fx:id="profileButton" mnemonicParsing="false"
               styleClass="profil-knapp" stylesheets="@Style.css" text="👤">
               <font>
                  <Font size="24.0" />
               </font>
            </Button>
         </children>
         <padding>
            <Insets left="20.0" right="20.0" />
         </padding>
      </HBox>
      <VBox alignment="TOP_CENTER" spacing="12.0" stylesheets="@Style.css" VBox.vgrow="ALWAYS">
         <padding>
            <Insets top="5.0" />
         </padding>
         <children>
            <Label fx:id="courseTitleLabel" alignment="CENTER" maxWidth="Infinity"
               minHeight="-Infinity" text="Fagnavn" textAlignment="CENTER" wrapText="true">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="Vurdering:">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
                  <Rating fx:id="ratingStars" max="5" rating="0" partialRating="false"
                     updateOnHover="false" />
               </children>
               <VBox.margin>
                  <Insets left="10.0" right="10.0" />
               </VBox.margin>
            </HBox>
            <HBox>
               <children>
                  <Label text="SKRIV INN KOMMENTAR:">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
               </children>
               <padding>
                  <Insets left="10.0" right="10.0" />
               </padding>
            </HBox>
            <TextArea fx:id="commentArea" prefHeight="128.0" prefWidth="380.0"
               promptText="Skriv her..." VBox.vgrow="ALWAYS" wrapText="true">
               <VBox.margin>
                  <Insets left="10.0" right="10.0" />
               </VBox.margin>
            </TextArea>
            <HBox>
               <children>
                  <Label text="Anonym?   ">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
               </children>
               <padding>
                  <Insets left="10.0" />
               </padding>
            </HBox>
            <HBox>
               <children>
                  <CheckBox fx:id="anonymousCheckBox" mnemonicParsing="false" text="Ja">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </CheckBox>
               </children>
               <padding>
                  <Insets left="10.0" right="10.0" />
               </padding>
            </HBox>
            <Label fx:id="statusLabel" alignment="CENTER" maxWidth="Infinity" minHeight="-Infinity"
               textAlignment="CENTER" wrapText="true">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <HBox>
               <children>
                  <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleSave"
                     styleClass="send-inn-knapp" stylesheets="@Style.css" text="ENDRE ✎">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Button>
               </children>
               <opaqueInsets>
                  <Insets left="10.0" />
               </opaqueInsets>
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
      <HBox alignment="CENTER" prefHeight="70.0" prefWidth="200.0" styleClass="header-bar"
         stylesheets="@Style.css">
         <children>
            <Button fx:id="backButton" maxHeight="1.7976931348623157E308"
               maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleBack"
               styleClass="bunn-knapp" stylesheets="@Style.css" text="TILBAKE" HBox.hgrow="ALWAYS">
               <font>
                  <Font name="System Bold" size="36.0" />
               </font>
            </Button>
            <Line endX="100.0" startX="100.0" startY="-67.57472229003906" />
            <Button fx:id="homeButton" maxHeight="1.7976931348623157E308"
               maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleHome"
               styleClass="bunn-knapp" stylesheets="@Style.css" text="HJEM" HBox.hgrow="ALWAYS">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Button>
         </children>
      </HBox>
   </children>
</VBox>